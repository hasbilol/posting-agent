# Meta Threads Graph API
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_60_day_access_token_here
THREADS_REFRESH_TOKEN=your_refresh_token_here

# Shopee Affiliate Open API (Malaysia)
SHOPEE_APP_ID=your_shopee_app_id_here
SHOPEE_APP_SECRET=your_shopee_app_secret_here

# LLM & Search (Multi-provider free router — tries in order until one succeeds)
# At least ONE of these is required for the pipeline to run
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: custom OpenAI-compatible endpoint (e.g. local FreeLLMAPI: http://127.0.0.1:31415/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto

TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Fallback affiliate link template (used when Shopee API is not configured)
AFFILIATE_LINK_TEMPLATE=https://shopee.com.my/?affiliate={item_id}